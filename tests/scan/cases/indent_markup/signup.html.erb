<div class="signup">
  <h2>Create an account</h2>
  <%= form_with model: @user do |f| %>
    <%= f.label :email, "Email address", class: "form-label" %>
    <%= f.text_field :email, class: "form-control", placeholder: "you@example.com" %>
    <%= f.submit "Sign up now", class: "btn btn-primary" %>
  <% end %>
  <p><%= link_to "Already have an account?", login_path, class: "small-link" %></p>
  <p><%= t(".routed_key") %></p>
  <% debug_note = "Internal developer note here" %>
</div>
