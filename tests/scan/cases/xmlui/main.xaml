<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Title="Account settings">
  <StackPanel>
    <TextBlock Text="Welcome back to your account" />
    <TextBlock Text="{Binding UserName}" />
    <Button Content="Save" ToolTip="Save your changes now" Command="{Binding SaveCommand}" />
    <Button Content="{x:Static res:Strings.Cancel}" x:Name="cancelButton" />
    <TextBox Watermark="Search by name" Width="200" />
  </StackPanel>
</Window>
